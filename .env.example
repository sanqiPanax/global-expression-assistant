# Without credentials the application runs in clearly labelled demo mode.
PORT=3210
# Compatible chat/completions API. Key stays on the server.
MODEL_BASE_URL=https://api.example.com/v1
MODEL_API_KEY=
MODEL_NAME=
# Optional provider routing header, e.g. x-opencode-session for OpenCode Go.
MODEL_SESSION_HEADER=
# Optional for accessing from a phone over a trusted LAN (default: 127.0.0.1).
# Never expose this unauthenticated development server to the public internet.
HOST=127.0.0.1
